# shellcheck shell=bash
# ~/.bash_bootstrap: sourced by one line in ~/.bashrc.
# Managed by ~/.dotfiles (module "bash"): this is a link to
# ~/.dotfiles/modules/bash/files/bash_bootstrap, so edit it there.

# ~/.local/bin holds mise and `dotfiles`. Ubuntu adds it to PATH only at login,
# and only if it existed then.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Everything below is for interactive shells only.
[[ $- == *i* ]] || return 0

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
  # Put the tools on PATH now, not only at the first prompt, so the lines
  # below can find them.
  eval "$(mise hook-env -s bash)"
  if command -v usage >/dev/null 2>&1; then
    eval "$(mise completion bash --include-bash-completion-lib)"
  fi
fi

if command -v oh-my-posh >/dev/null 2>&1; then
  eval "$(oh-my-posh init bash)"
fi
