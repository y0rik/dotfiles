#!/usr/bin/env bash
# Stub mise for tests/runner.bats. Behaviour per module id comes from env:
#   STUB_FAIL / STUB_TASKFAIL / STUB_TOOLFAIL / STUB_SKIP / STUB_WARN / STUB_MISSING   space-separated ids
#   STUB_MISE_VERSION                                   version to report
#   STUB_MISE_LOG                                       every call is appended here
set -euo pipefail

in_list() { [[ " ${!1:-} " == *" $2 "* ]]; }

printf 'MISE_CONFIG_DIR=%s %s\n' "${MISE_CONFIG_DIR:-}" "$*" >>"${STUB_MISE_LOG:-/dev/null}"

if [[ "${1:-}" == --version ]]; then
  printf '%s linux-x64 (2026-11-10)\n' "${STUB_MISE_VERSION:-2026.11.9}"
  exit 0
fi

id=""
if [[ "${1:-}" == -E ]]; then id="$2"; shift 2; fi
[[ "${1:-}" == bootstrap ]] || { echo "stub mise: unsupported call: $*" >&2; exit 64; }
shift

if [[ "${1:-}" == status ]]; then
  if in_list STUB_MISSING "$id"; then
    echo "dnf:wget  missing"
    exit 1
  fi
  exit 0
fi

# The module must be reachable the way real mise finds it: conf.d/<id>/mise.<id>.toml
if [[ ! -f "$MISE_CONFIG_DIR/conf.d/$id/mise.$id.toml" ]]; then
  echo "stub mise: no config for env $id under $MISE_CONFIG_DIR/conf.d" >&2
  exit 65
fi

if in_list STUB_FAIL "$id"; then
  echo "dnf: installing packages for $id"
  echo "Failed to resolve the transaction:"
  echo "Error: No match for argument: $id-ce"
  echo "mise ERROR dnf exited with non-zero status: exit code 1"
  echo "mise ERROR Version: 2026.11.9 linux-x64 (2026-11-16)"
  echo "mise ERROR Run with --verbose or MISE_VERBOSE=1 for more information"
  exit 1
fi
if in_list STUB_TOOLFAIL "$id"; then
  # Real mise output when one of several [tools] fails (node without libatomic).
  echo "mise bootstrap: tools"
  echo "mise node@26.13.1 /home/u/.local/share/mise/installs/node/26.13.1/bin/node: error while loading shared libraries: libatomic.so.1: cannot open shared object file: No such file or directory"
  echo "mise ERROR ~/.local/share/mise/installs/node/26.13.1/bin/node failed"
  echo "mise ✗ node@26.13.1   9.5s · failed: ~/.local/share/mise/installs/node/26.13.1/bin/node exited with non-zero status: exit code 127; last stderr: /home/u/.local/share/mise/installs/node/26.13.1/bin/node: error while loading shared libraries: libatomic.so.1: cannot open shared object file: No such file or directory"
  echo "mise ✓ go@1.27.4      17.3s  go1.27.4.linux-amd64.tar.gz"
  echo "mise ✗ npm:some-cli@latest · failed: Skipped due to failed dependency"
  echo "mise ████████████████ 3/3 · installed 2 tools · 1 failed in 20.1s"
  echo "mise ERROR installation failed; previous lockfiles were preserved"
  echo "mise ERROR Version: 2026.11.10 linux-x64 (2026-11-18)"
  echo "mise ERROR Run with --verbose or MISE_VERBOSE=1 for more information"
  exit 1
fi
if in_list STUB_TASKFAIL "$id"; then
  echo "mise bootstrap: running \`bootstrap\` task"
  echo "mise ERROR task bootstrap failed: exit code 7"
  echo "mise ERROR Version: 2026.11.9 linux-x64 (2026-11-16)"
  echo "mise ERROR Run with --verbose or MISE_VERBOSE=1 for more information"
  exit 7
fi
if in_list STUB_SKIP "$id"; then
  echo "SKIP: no NVIDIA GPU"
  echo "mise ERROR task bootstrap failed with exit code 3"
  exit 3
fi
if in_list STUB_WARN "$id"; then
  echo "mise WARN  unknown field \`pakages\` in mise.$id.toml"
fi
echo "applied $id $*"
